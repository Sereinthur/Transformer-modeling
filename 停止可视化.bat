@echo off
setlocal EnableExtensions
set "PORT=8001"
powershell -NoProfile -Command "$listener = Get-NetTCPConnection -State Listen -LocalPort %PORT% -ErrorAction SilentlyContinue | Select-Object -First 1; if (-not $listener) { Write-Host 'Visual Modeling is not running.'; exit 0 }; $processInfo = Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $listener.OwningProcess); if ($processInfo.Name -notmatch '^python(\.exe)?$' -or $processInfo.CommandLine -notmatch 'transformer_modeling\.visual_app') { Write-Host ('Refusing to stop PID ' + $listener.OwningProcess + ': owner is ' + $processInfo.Name); exit 2 }; $parentTargets = @(); $parentPid = $processInfo.ParentProcessId; while ($parentPid -gt 0) { $parentInfo = Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $parentPid); if (-not $parentInfo) { break }; $isLauncher = $parentInfo.Name -match '^py(w)?(\.exe)?$' -or ($parentInfo.Name -eq 'cmd.exe' -and $parentInfo.CommandLine -match '启动可视化\.bat'); if (-not $isLauncher) { break }; $parentTargets += $parentInfo.ProcessId; $parentPid = $parentInfo.ParentProcessId }; foreach ($targetPid in $parentTargets) { Stop-Process -Id $targetPid -Force -ErrorAction SilentlyContinue }; Stop-Process -Id $processInfo.ProcessId -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 300; $remaining = Get-NetTCPConnection -State Listen -LocalPort %PORT% -ErrorAction SilentlyContinue; if ($remaining) { Write-Host ('Failed to stop Visual Modeling on port %PORT%.'); exit 3 }; Write-Host ('Stopped Visual Modeling (PID ' + $processInfo.ProcessId + ').')"
if errorlevel 1 pause
