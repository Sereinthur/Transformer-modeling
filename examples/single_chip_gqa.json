{
  "_说明": "单芯片GQA模型示例。所有容量用byte、带宽用byte/s、时间用second。",
  "schema_version": 2,
  "hardware": {
    "_说明": "芯片峰值算力、矩阵Tile、HBM和运行时启动参数。",
    "name": "example_100t_80g_accelerator",
    "device_count": 1,
    "compute": {
      "_说明": "按模型权重精度选择对应的dense峰值吞吐。",
      "throughput": {
        "fp16_dense_ops_per_second": 100000000000000
      },
      "matrix_tile": {
        "m": 16,
        "n": 16,
        "k": 16
      }
    },
    "device_memory": {
      "_说明": "若填写实测读取带宽，模型直接将其作为有效payload带宽。",
      "type": "HBM",
      "capacity_bytes": 85899345920,
      "peak_bandwidth_bytes_per_second": 2000000000000,
      "reserved_capacity_bytes": 1073741824
    },
    "runtime": {
      "kernel_launch_latency_seconds": 5e-06
    },
    "interconnect": {
      "topology": "ring",
      "effective_channel_bandwidth_bytes_per_second": 100000000000,
      "collective_step_latency_seconds": 2e-06
    }
  },
  "model": {
    "id": "decoder_only",
    "name": "decoder_only",
    "dimensions": {
      "layer_count": 32,
      "hidden_size": 4096,
      "intermediate_size": 11008,
      "vocab_size": 32000,
      "padded_vocab_size": 32000
    },
    "embedding": {
      "type": "token_embedding",
      "tied_lm_head": true
    },
    "layer_pattern": [
      {
        "repeat": 1,
        "norm": {
          "type": "rms_norm"
        },
        "attention": {
          "type": "standard_attention",
          "implementation": "flash_attention",
          "query_heads": 32,
          "kv_heads": 8,
          "head_dim": 128,
          "query_width_equals_hidden": true
        },
        "residual": {
          "type": "standard_residual"
        },
        "ffn": {
          "type": "gated_ffn",
          "implementation": "swiglu",
          "intermediate_size": 11008
        }
      }
    ],
    "output": {
      "norm": {
        "type": "rms_norm"
      },
      "head": {
        "type": "lm_head"
      },
      "sampling": {
        "type": "sampling"
      }
    },
    "dtype": {
      "weight": "fp16",
      "activation": "fp16",
      "kv_cache": "fp16",
      "state": "fp16",
      "accumulation": "fp32",
      "logits": "fp32"
    },
    "inference": {
      "prefill_logits_mode": "last_token"
    },
    "quantization": {
      "block_size": 32,
      "scale_bytes": 1
    },
    "metadata": {
      "family": "decoder_only",
      "mapping_quality": "migrated_example",
      "unsupported_features": []
    }
  },
  "serving": {
    "_说明": "固定等长Batch；output_length包含Prefill产生的首token。",
    "batch_size": 1,
    "prompt_length": {
      "distribution": "fixed",
      "value": 2048
    },
    "output_length": {
      "distribution": "fixed",
      "value": 128
    },
    "max_sequence_length": 4096
  },
  "execution": {
    "_说明": "融合开关、重叠方式和Prefill/Decode效率校准参数。",
    "fusion": {
      "flash_attention": true,
      "rope_kv_write": true,
      "gated_mlp": true,
      "rmsnorm_linear": true
    },
    "overlap": {
      "_说明": "rho=0表示计算与HBM充分重叠，rho=1表示完全串行。",
      "mode": "bounded_interpolation",
      "interpolation_rho": 0.1,
      "tp_interpolation_rho": 1.0,
      "prefill_tp_interpolation_rho": 0.5,
      "decode_tp_interpolation_rho": 1.0
    },
    "efficiencies": {
      "_说明": "公开端到端实测约束下的Dense经验初值，不是理论常数或单算子直接实测值。",
      "prefill_gemm": 0.65,
      "decode_gemm": 0.2,
      "prefill_attention": 0.5,
      "decode_attention": 0.15,
      "vector": 0.15,
      "hbm": 0.75
    },
    "memory": {
      "kv_paged": true,
      "kv_page_tokens": 16
    }
  },
  "parallelism": {
    "tensor_parallel": 1,
    "kv_head_policy": "shard_or_group_replicate",
    "expert_parallel": 1
  }
}
